# =============================================================================
# BSCA Expert Agent Configuration
# =============================================================================
# Copy this file to .env and fill in actual values

# =============================================================================
# Database Configuration
# =============================================================================
# Use the new database
USE_NEW_DATABASE=true

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=2345
POSTGRES_USERNAME=open_binary_sca
POSTGRES_PASSWORD=open_binary_sca
POSTGRES_DATABASE_MAIN=open_binary_sca
POSTGRES_DATABASE_KNOWLEDGE=knowledge

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis server configuration
REDIS_HOST=bsca-expert-redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis database allocations
REDIS_DB_BROKER=0
REDIS_DB_RESULT=0
REDIS_DB_METADATA=2

# =============================================================================
# MinIO Configuration
# =============================================================================
# MinIO server endpoint (without http://)
MINIO_ENDPOINT=localhost:9000
# MinIO access key
MINIO_ACCESS_KEY=your_access_key_here
MINIO_SECRET_KEY=your_secret_key_here
# Use HTTPS
MINIO_SECURE=false
# Bucket names
MINIO_INPUT_BUCKET=input-files
MINIO_OUTPUT_BUCKET=output-results
# Local temp directory
LOCAL_TEMP_DIR=/tmp/bsca_analysis

# =============================================================================
# Large Language Model Configuration
# =============================================================================
# LLM provider: "openai", "anthropic", "ollama"
LLM_PROVIDER=openai
# Model ID
LLM_MODEL_ID=gpt-4.1

# API keys (fill in keys for the chosen provider)
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama configuration (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Required Configuration
# =============================================================================
# Knowledge files path (required)
KNOWLEDGE_FILE_PATH=/path/to/your/knowledge/files

# =============================================================================
# API Service Configuration
# =============================================================================
# App metadata
APP_NAME=BSCA Expert Agent API
APP_VERSION=0.1.0
# Server binding
APP_HOST=0.0.0.0
APP_PORT=8000
# Debug mode
APP_DEBUG=true