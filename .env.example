# =============================================================================
# BSCA Expert Agent Configuration
# =============================================================================
# 复制此文件为 .env 并填写实际的配置值

# =============================================================================
# 数据库配置 (Database Configuration)
# =============================================================================
# 是否使用新数据库
USE_NEW_DATABASE=false

# PostgreSQL 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=2345
POSTGRES_USERNAME=open_binary_sca
POSTGRES_PASSWORD=open_binary_sca
POSTGRES_DATABASE_MAIN=open_binary_sca
POSTGRES_DATABASE_KNOWLEDGE=knowledge

# =============================================================================
# Redis 配置 (Redis Configuration)
# =============================================================================
# Redis 服务器配置
REDIS_HOST=bsca-expert-redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis 数据库分配
REDIS_DB_BROKER=0
REDIS_DB_RESULT=0
REDIS_DB_METADATA=2

# =============================================================================
# MinIO 对象存储配置 (MinIO Configuration)
# =============================================================================
# MinIO 服务器地址 (不包含 http://)
MINIO_ENDPOINT=localhost:9000
# MinIO 访问密钥
MINIO_ACCESS_KEY=your_access_key_here
MINIO_SECRET_KEY=your_secret_key_here
# 是否使用 HTTPS
MINIO_SECURE=false
# 存储桶名称
MINIO_INPUT_BUCKET=input-files
MINIO_OUTPUT_BUCKET=output-results
# 本地临时目录
LOCAL_TEMP_DIR=/tmp/bsca_analysis

# =============================================================================
# LLM 配置 (Large Language Model Configuration)
# =============================================================================
# LLM 提供商: "openai", "anthropic", "ollama"
LLM_PROVIDER=openai
# 模型 ID
LLM_MODEL_ID=gpt-4.1

# API 密钥 (根据选择的提供商填写对应的密钥)
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama 配置 (如果使用 Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# 必需配置 (Required Configuration)
# =============================================================================
# 知识文件路径 (必须配置)
KNOWLEDGE_FILE_PATH=/path/to/your/knowledge/files

# =============================================================================
# API 服务配置 (API Service Configuration)
# =============================================================================
# 应用基本信息
APP_NAME=BSCA Expert Agent API
APP_VERSION=0.1.0
# 服务监听配置
APP_HOST=0.0.0.0
APP_PORT=8000
# 调试模式
APP_DEBUG=true