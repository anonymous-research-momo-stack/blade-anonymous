{% set compiler, version, compiler_exe = detect_api.detect_default_compiler() %}


[settings]
arch=x86_64
build_type=Release
compiler=clang
compiler.version={{detect_api.default_compiler_version('gcc', version)}}
compiler.libcxx={{detect_api.detect_libcxx('gcc', version, compiler_exe)}}
compiler.cppstd={{detect_api.default_cppstd('gcc', version)}}
os=Linux

[options]
*:shared=True

[buildenv]
CC=/usr/bin/clang
CXX=/usr/bin/clang++